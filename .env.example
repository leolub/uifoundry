# Local Docker Compose defaults. Copy to .env and change secrets locally.
POSTGRES_DB=uifoundry
POSTGRES_USER=uifoundry
POSTGRES_PASSWORD=uifoundry_local_only
DATABASE_URL=jdbc:postgresql://postgres:5432/uifoundry
DATABASE_USERNAME=uifoundry
DATABASE_PASSWORD=uifoundry_local_only
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Authentication. Use at least 32 UTF-8 bytes for JWT_SECRET outside local development.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=3600

# Source screenshot storage. Docker uses its own /data/source-images volume by default.
UIFOUNDRY_STORAGE_DIR=./storage/source-images
UIFOUNDRY_MAX_UPLOAD_SIZE=10MB
UIFOUNDRY_MAX_UPLOAD_BYTES=10485760

# Added in later phases. Never commit real credentials.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_API_TOKEN=
